<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\App.ico</ApplicationIcon>
    <AssemblyName>DaydayPDF.Setup</AssemblyName>
    <Version>$(PreviewPackageVersion)</Version><InformationalVersion>$(PreviewChannel) $(PreviewDisplayVersion)</InformationalVersion>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\PrintInbox.cs" Link="PrintInbox.cs" />
    <EmbeddedResource Include="$(ReceiverPath)" LogicalName="DaydayPDF.PrintReceiver.exe" Condition="'$(ReceiverPath)' != ''" />
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="DaydayPDF.exe" Condition="'$(PayloadPath)' != ''" />
    <EmbeddedResource Include="InstallPrinter.ps1" LogicalName="InstallPrinter.ps1" />
    <EmbeddedResource Include="..\PdfFile.ico" LogicalName="DaydayPDF.pdf.ico" />
  </ItemGroup>
</Project>
