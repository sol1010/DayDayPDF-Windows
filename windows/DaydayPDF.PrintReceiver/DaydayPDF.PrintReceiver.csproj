<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DaydayPDF.PrintReceiver</AssemblyName>
    <Version>$(PreviewPackageVersion)</Version>
    <InformationalVersion>$(PreviewChannel) $(PreviewDisplayVersion)</InformationalVersion>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <InternalsVisibleTo Include="DaydayPDF.PrintReceiver.Tests" />
  </ItemGroup>
  <ItemGroup><Compile Include="../Shared/PrintInbox.cs" Link="PrintInbox.cs" /></ItemGroup>
</Project>
