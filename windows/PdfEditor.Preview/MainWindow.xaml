                        </Viewbox>
                        <ProgressBar x:Name="ContentLoadingProgress"
                                     Width="168"
                                     Height="3"
                                     Margin="0,27,0,0"
                                     Background="#30343A"
                                     Foreground="#F3F5F7"
                                     BorderThickness="0"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed" />
                        <TextBlock x:Name="LoadingStatusText"
                                   Margin="0,22,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#AEB4BD"
                                   FontSize="12.5"
                                   Text="" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="StartupLoadingOverlay"
                    Grid.RowSpan="2"
                    Panel.ZIndex="100"
                    Background="#0C0D0F">
                <Viewbox Width="310"
                         MaxWidth="310"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Stretch="Uniform">
